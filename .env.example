# Hugging Face — obrigatório para treino/inferência real (solicite acesso a meta-llama/Llama-2-7b-hf)
# No Colab: use Secrets (HF_TOKEN) — ver notebooks/02_fine_tuning_colab.ipynb
HF_TOKEN=

# Local sem GPU: USE_MOCK_LLM=1 (pula download do LLaMA)
USE_MOCK_LLM=

BASE_MODEL_ID=meta-llama/Llama-2-7b-hf
# Após treinar no Colab, extraia lora_adapter_colab.zip em ./artifacts/lora_adapter/
LORA_ADAPTER_PATH=./artifacts/lora_adapter
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_URL=sqlite:///data/synthetic/hospital.db
LOG_PATH=./logs/interactions.jsonl
CHROMA_PATH=./artifacts/chroma_db
